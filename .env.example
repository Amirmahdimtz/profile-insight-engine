# Copy to .env, replace both passwords with 64 hex characters from `openssl rand -hex 32`,
# and protect the file with chmod 600. Do not commit .env.
POSTGRES_DB=profile_insight
POSTGRES_USER=profile_insight_admin
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_64_HEX_CHAR_SECRET
APP_DB_USER=profile_insight_app
APP_DB_PASSWORD=REPLACE_WITH_APP_64_HEX_CHAR_SECRET

# Convenience tags for initial verification. Pin approved image digests before production.
APP_IMAGE_TAG=local
PYTHON_BASE_IMAGE=python:3.12.10-slim-bookworm
POSTGRES_IMAGE=postgres:17-alpine
NGINX_IMAGE=nginx:stable-alpine

# Immutable upstream commit containing the selected official tessdata_best files.
TESSDATA_BEST_REVISION=e12c65a915945e4c28e237a9b52bc4a8f39a0cec
